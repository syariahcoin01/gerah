# Salin ke .env lalu sesuaikan.

# --- Registry tujuan push (pilih salah satu) ---
# GitHub Container Registry:   ghcr.io/<akun-atau-org>
# Docker Hub:                  docker.io/<nama-akun>
# Registry kampus (Harbor):    registry.widyatama.ac.id/si
REGISTRY=ghcr.io/prodi-si-widyatama
TAG=latest

# --- Database ---
POSTGRES_USER=gerah
POSTGRES_PASSWORD=ganti-dengan-password-kuat
POSTGRES_DB=gerah

# --- Jaringan ---
# :80 = HTTP biasa. Isi domain (mis. gerah.si.widyatama.ac.id) untuk HTTPS otomatis.
SITE_ADDRESS=:80
# Di server produksi biasanya 80 dan 443
HTTP_PORT=8080
HTTPS_PORT=8443
CORS_ORIGINS=*

# --- Data ---
INGEST_INTERVAL_MIN=60
# true hanya untuk kelas/demo tanpa internet (data sintetis berlabel "demo")
DEMO_FALLBACK=false
WEB_API_URL=/api
